# Paths are relative to the workspace root.
# Seed reads DB_PATH; DATABASE_PATH remains a supported legacy fallback.
DB_PATH=./data/foodops.sqlite
MCP_HOST=127.0.0.1
PORT=3001
# Optional legacy fallback when PORT is absent: MCP_PORT.
# Optional comma-separated host:port authorities; empty uses loopback at PORT.
ALLOWED_HOSTS=
# Required for HTTP: at least 32 characters without whitespace.
MCP_AUTH_TOKEN=
# Optional shared confirmation HMAC secret: at least 32 characters.
# Unset uses a random process-local secret; restart invalidates outstanding tokens.
MCP_CONFIRM_SECRET=
LOG_LEVEL=info

# Dashboard API foundation. Keep this token separate from MCP_AUTH_TOKEN.
API_HOST=127.0.0.1
API_PORT=3002
ADMIN_TOKEN=
# Optional REST confirmation secret, 32+ characters without whitespace.
API_CONFIRM_SECRET=
# Exact origins, comma-separated; credentials are disabled.
WEB_ORIGIN=http://localhost:5173
# on explicitly enables autonomous synthetic traffic through core services.
SIMULATOR=off
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_SEED=42
SIMULATOR_MAX_ACTIVE=60
CHANGE_FEED_POLL_MS=500
CALL_LOG_RETENTION_DAYS=30
SSE_MAX_STREAMS=50
SSE_REPLAY_LIMIT=1000
RATE_LIMIT_PER_MIN=1200
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_TICKET_PER_MIN=60

# LLM provider layer: cloud providers normally require a key; local servers may not.
LLM_PROVIDER=ollama
# Omit to use provider default; explicit bases preserve their path (OpenAI includes /v1).
# LLM_BASE_URL=http://localhost:11434
# Required only when attempting a chat.
LLM_MODEL=
LLM_API_KEY=
LLM_TOOL_MODE=auto
LLM_NUM_CTX=16384
LLM_TEMPERATURE=0.2
LLM_FIRST_BYTE_TIMEOUT_MS=60000
LLM_IDLE_TIMEOUT_MS=30000
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=2
LLM_THINK=off
LLM_CONTEXT_BUDGET_TOKENS=12000

# Lazy MCP connection; boot does not require a running MCP server.
MCP_URL=http://127.0.0.1:3001/mcp
MCP_CALL_TIMEOUT_MS=10000
MCP_TOOLS_TTL_MS=60000
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_RUN_TIMEOUT_MS=300000
