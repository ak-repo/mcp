# Paths are relative to the workspace root.
# Seed reads DB_PATH; DATABASE_PATH remains a supported legacy fallback.
DB_PATH=./data/foodops.sqlite
MCP_HOST=127.0.0.1
PORT=3001
# Optional legacy fallback when PORT is absent: MCP_PORT.
# Optional comma-separated host:port authorities; empty uses loopback at PORT.
ALLOWED_HOSTS=
# Required for HTTP: at least 32 characters without whitespace.
MCP_AUTH_TOKEN=
# Optional shared confirmation HMAC secret: at least 32 characters.
# Unset uses a random process-local secret; restart invalidates outstanding tokens.
MCP_CONFIRM_SECRET=
LOG_LEVEL=info
