{
  "name": "@foodops/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @foodops/shared build && vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "pnpm --filter @foodops/shared build && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @foodops/shared build && vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "@foodops/shared": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "radix-ui": "1.4.3",
    "cmdk": "1.1.1",
    "sonner": "2.0.7",
    "lucide-react": "0.468.0",
    "@tanstack/react-query": "5.90.2",
    "react-router": "7.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "@fontsource-variable/inter": "5.2.6",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "tailwindcss": "4.1.13",
    "@tailwindcss/postcss": "4.1.13",
    "postcss": "8.5.6",
    "@testing-library/react": "16.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/jest-dom": "6.6.3",
    "jsdom": "26.1.0"
  }
}
