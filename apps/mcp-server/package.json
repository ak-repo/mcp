{
  "name": "@foodops/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b tsconfig.typecheck.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "dev": "tsx src/transports/stdio.ts",
    "start:http": "node dist/transports/http.js"
  },
  "dependencies": {
    "@foodops/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pino": "10.4.0",
    "@foodops/shared": "workspace:*",
    "zod": "4.6.7"
  }
}
