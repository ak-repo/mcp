{
  "name": "foodops-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/core apps/mcp-server",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @foodops/core seed",
    "dev:mcp": "pnpm --filter @foodops/mcp-server dev",
    "migrate": "pnpm --filter @foodops/core migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
